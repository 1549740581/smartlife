.description {
  margin-top: 20rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #374151;
}

.hero-main {
  flex: 1;
}

.hero-actions {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.favorite-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.favorite-btn.active {
  background: rgba(255, 215, 0, 0.3);
}

.favorite-icon {
  font-size: 36rpx;
  color: #fff;
}

.favorite-btn.active .favorite-icon {
  color: #ffd700;
}

.hero-status {
  margin-top: 0;
  margin-left: 20rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #ffffff;
}

.detail-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 24rpx;
}

.detail-badge {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  color: #ffffff;
  font-size: 22rpx;
}

.contact-panel {
  padding: 10rpx 0 4rpx;
}

.contact-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #eef2f7;
}

.contact-row:last-child {
  border-bottom: none;
}

.contact-label {
  font-size: 24rpx;
  color: #7b8798;
}

.contact-value {
  font-size: 28rpx;
  color: #18212f;
  font-weight: 600;
}

.image-list {
  white-space: nowrap;
}

.preview-image {
  display: inline-block;
  width: 220rpx;
  height: 220rpx;
  margin-right: 16rpx;
  border-radius: 24rpx;
  background: #e5e7eb;
  box-shadow: 0 10rpx 22rpx rgba(21, 37, 63, 0.12);
}
