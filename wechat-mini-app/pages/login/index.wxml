<view class="page">
  <view class="hero-card">
    <view class="hero-kicker">SMART LIFE</view>
    <view class="hero-title">登录账号</view>
    <view class="hero-copy">未登录时默认以访客身份浏览公开信息。登录后可以进入个人中心发布房屋、车位或闲置物品。</view>
  </view>

  <view class="card">
    <view class="title">微信模拟登录</view>
    <view class="field">
      <text class="label">登录 code</text>
      <input class="input" placeholder="输入任意 code 作为 openId" bindinput="onCodeInput" value="{{code}}" />
    </view>
    <view class="field">
      <text class="label">昵称</text>
      <input class="input" placeholder="输入昵称，不填则使用系统昵称" bindinput="onNicknameInput" value="{{nickname}}" />
    </view>
    <button class="button" bindtap="login">登录并进入首页</button>
  </view>

  <view class="note-card">
    <view class="section-title">演示账号</view>
    <view class="meta">审核员：{{reviewerCodes[0]}}、{{reviewerCodes[1]}}</view>
    <view class="meta">普通用户：{{normalCodes[0]}}、{{normalCodes[1]}}</view>
    <view class="demo-action-row">
      <button class="button button-secondary demo-button" data-code="{{reviewerCodes[0]}}" bindtap="useDemoCode">填充审核员示例</button>
      <button class="button button-secondary demo-button" data-code="{{normalCodes[0]}}" bindtap="useDemoCode">填充普通用户示例</button>
    </view>
  </view>
</view>
