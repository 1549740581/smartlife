.textarea {
  width: 100%;
  height: 200rpx;
  padding: 20rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
  background: #fafbfc;
}

.char-count {
  text-align: right;
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 10rpx;
}

.required {
  color: #ef4444;
}

.upload-tip {
  font-size: 24rpx;
  color: #9ca3af;
  margin-bottom: 20rpx;
}

.upload-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.upload-item {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.upload-preview {
  width: 100%;
  height: 100%;
  background: #e5e7eb;
}

.video-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #374151;
}

.video-icon {
  font-size: 48rpx;
  color: #ffffff;
}

.upload-remove {
  position: absolute;
  top: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #ffffff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 16rpx 0 16rpx;
}

.upload-add {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f3f4f6;
  border: 2rpx dashed #d1d5db;
}

.upload-icon {
  font-size: 56rpx;
  color: #9ca3af;
}
