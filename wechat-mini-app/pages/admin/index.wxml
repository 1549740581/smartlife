<view class="page">
  <view class="card" wx:if="{{!adminToken}}">
    <view class="title">审核台登录</view>
    <view class="meta">只有个人中心展示“后台审核”的指定账号才应进入本页。</view>
    <view class="field">
      <text class="label">用户名</text>
      <input class="input" value="{{username}}" bindinput="onUsernameInput" />
    </view>
    <view class="field">
      <text class="label">密码</text>
      <input class="input" password value="{{password}}" bindinput="onPasswordInput" />
    </view>
    <button class="button" bindtap="login">登录</button>
  </view>

  <view wx:else>
    <view class="hero-card">
      <view class="hero-top">
        <view>
          <view class="hero-kicker">SMART LIFE</view>
          <view class="hero-title">审核工作台</view>
        </view>
        <view class="identity-badge">{{pendingRentals.length}} 条待处理</view>
      </view>
      <view class="hero-copy">会话有效期至：{{expiresAt || '-'}}</view>
      <view class="demo-action-row">
        <button class="button button-secondary demo-button" bindtap="loadDashboard">刷新列表</button>
        <button class="button button-secondary demo-button" bindtap="logout">退出登录</button>
      </view>
    </view>

    <view class="empty-card" wx:if="{{!pendingRentals.length}}">
      <view class="empty-title">当前没有待审核信息</view>
      <view class="meta">公开广场只会展示审核通过的内容。</view>
    </view>

    <block wx:for="{{pendingRentals}}" wx:key="id">
      <view class="record-card">
        <view class="record-top">
          <view class="record-title">{{item.title}}</view>
          <view class="listing-tag">{{item.typeLabel}}</view>
        </view>
        <view class="record-desc">{{item.description}}</view>
        <view class="record-meta">{{item.priceText}} · 联系人：{{item.contactName}} {{item.contactPhone}}</view>
        <view class="admin-actions">
          <button class="button button-secondary admin-button" data-id="{{item.id}}" bindtap="goDetail">查看详情</button>
          <button class="button admin-button" data-id="{{item.id}}" loading="{{reviewingId === item.id}}" disabled="{{reviewingId === item.id}}" bindtap="approveReview">审核通过</button>
          <button class="button button-secondary admin-button" data-id="{{item.id}}" disabled="{{reviewingId === item.id}}" bindtap="openRejectForm">审核拒绝</button>
        </view>
        <view class="reject-panel" wx:if="{{activeRejectId === item.id}}">
          <view class="label">拒绝原因</view>
          <textarea
            class="textarea reject-textarea"
            placeholder="请输入拒绝原因，发布者会在个人中心看到"
            maxlength="200"
            data-id="{{item.id}}"
            bindinput="onRejectReasonInput"
            value="{{rejectReasons[item.id] || ''}}"
          />
          <view class="admin-actions inline-actions">
            <button class="button button-secondary admin-button" bindtap="cancelReject" disabled="{{reviewingId === item.id}}">取消</button>
            <button class="button admin-button" data-id="{{item.id}}" loading="{{reviewingId === item.id}}" disabled="{{reviewingId === item.id}}" bindtap="submitReject">确认拒绝</button>
          </view>
        </view>
      </view>
    </block>

    <view class="section-head">
      <view class="section-title">订单管理</view>
      <view class="section-meta">{{orderList.length}} 条订单</view>
    </view>

    <view class="empty-card" wx:if="{{!orderList.length}}">
      <view class="empty-title">暂无订单</view>
      <view class="meta">租期卡片经房东确认后，会在这里展示并支持管理员直接取消。</view>
    </view>

    <block wx:for="{{orderList}}" wx:key="id">
      <view class="record-card">
        <view class="record-top">
          <view class="record-title">{{item.rentalTitle}}</view>
          <view class="listing-tag">{{item.statusLabel}}</view>
        </view>
        <view class="record-meta">{{item.typeLabel}} · {{item.dateText}}</view>
        <view class="record-meta">房东：{{item.landlordNickname || ('用户' + item.landlordUserId)}} · 租客：{{item.tenantNickname || ('用户' + item.tenantUserId)}}</view>
        <view class="record-reason" wx:if="{{item.cancelReason}}">{{item.cancelReason}}</view>
        <button
          class="button button-secondary admin-button"
          wx:if="{{item.canCancel}}"
          data-id="{{item.id}}"
          loading="{{cancelingOrderId === item.id}}"
          disabled="{{cancelingOrderId === item.id}}"
          bindtap="cancelOrder"
        >
          {{cancelingOrderId === item.id ? '取消中...' : '管理员取消订单'}}
        </button>
      </view>
    </block>
  </view>
</view>
