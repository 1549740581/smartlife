<view class="page">
  <view class="hero-card">
    <view class="hero-kicker">SMART LIFE</view>
    <view class="hero-title">我的投诉</view>
  </view>

  <block wx:if="{{loading}}">
    <view class="empty-card">
      <view class="empty-title">加载中...</view>
    </view>
  </block>

  <block wx:elif="{{complaints.length === 0}}">
    <view class="empty-card">
      <view class="empty-title">暂无投诉记录</view>
      <view class="empty-subtitle">您还没有提交过任何投诉</view>
    </view>
  </block>

  <block wx:else>
    <view class="card" wx:for="{{complaints}}" wx:key="id" data-id="{{item.id}}" bindtap="viewDetail">
      <view class="complaint-header">
        <view class="complaint-title">{{item.rentalTitle}}</view>
        <view class="status status-{{item.statusClass}}">{{item.statusText}}</view>
      </view>
      <view class="complaint-reason">{{item.reason}}</view>
      <view class="complaint-meta">
        <text>被投诉人：{{item.targetUserNickname}}</text>
        <text class="complaint-time">{{item.createdAtText}}</text>
      </view>
      <view class="complaint-process" wx:if="{{item.status !== 'PENDING' && item.processRemark}}">
        <text class="process-label">处理结果：</text>
        <text>{{item.processRemark}}</text>
      </view>
    </view>
  </block>
</view>
