<view class="page">
  <view class="hero-card">
    <view class="hero-top">
      <view>
        <view class="hero-kicker">SMART LIFE</view>
        <view class="hero-title">生活广场</view>
      </view>
      <view class="identity-badge">{{identityText}}</view>
    </view>
    <view class="hero-copy">浏览社区里已经审核通过的房屋、车位和闲置物品，快速找到靠谱信息。</view>
  </view>

  <view class="filter-card">
    <view class="section-title">筛选搜索</view>
    <input
      class="input search-input-light"
      placeholder="搜索标题、描述或联系方式"
      confirm-type="search"
      bindinput="onKeywordInput"
      bindconfirm="onKeywordConfirm"
      value="{{keyword}}"
    />
    <picker
      class="picker-field search-picker"
      mode="multiSelector"
      range="{{addressRange}}"
      value="{{addressValue}}"
      bindchange="onAddressChange"
      bindcolumnchange="onAddressColumnChange"
    >
      <view class="picker-value location-picker">{{selectedAddressText}}</view>
    </picker>
    <view class="pill-group filter-pill-group">
      <view class="pill {{activeType === 'ALL' ? 'pill-active' : ''}}" data-type="ALL" bindtap="switchType">全部</view>
      <view class="pill {{activeType === 'HOUSE' ? 'pill-active' : ''}}" data-type="HOUSE" bindtap="switchType">房屋</view>
      <view class="pill {{activeType === 'PARKING' ? 'pill-active' : ''}}" data-type="PARKING" bindtap="switchType">车位</view>
      <view class="pill {{activeType === 'ITEM' ? 'pill-active' : ''}}" data-type="ITEM" bindtap="switchType">闲置物品</view>
    </view>
    <view class="filter-actions">
      <button class="button filter-button" bindtap="search">搜索</button>
      <button class="button button-secondary filter-button" bindtap="clearFilters">重置</button>
    </view>
  </view>

  <view class="section-head">
    <view class="section-title">公开信息</view>
    <view class="section-meta">{{rentals.length}} 条内容</view>
  </view>

  <view class="empty-card" wx:if="{{!rentals.length}}">
    <view class="empty-title">暂无内容</view>
    <view class="meta">当前还没有审核通过的信息可以展示。</view>
  </view>

  <block wx:for="{{rentals}}" wx:key="id">
    <view class="listing-card" data-id="{{item.id}}" bindtap="goDetail">
      <view class="favorite-badge" wx:if="{{favoriteIds.includes(item.id)}}">★ 已收藏</view>
      <view class="listing-top">
        <view class="listing-tag">{{item.typeLabel}}</view>
        <view class="listing-price">{{item.priceText}}</view>
      </view>
      <view class="listing-title">{{item.title}}</view>
      <view class="listing-desc">{{item.description}}</view>
      <view class="listing-meta">所在位置：{{item.locationText || '杭州 / 未填写'}}</view>
      <view class="listing-contact">
        <view class="contact-chip">{{item.contactName}}</view>
        <view class="contact-chip">{{item.contactPhone}}</view>
      </view>
    </view>
  </block>
</view>
