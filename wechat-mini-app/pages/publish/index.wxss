.button {
  margin-top: 24rpx;
}

.card {
  padding-top: 24rpx;
}

.helper-text {
  margin-top: 12rpx;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
  gap: 16rpx;
}

.image-item {
  position: relative;
}

.preview-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 24rpx;
  background: #e5e7eb;
  box-shadow: 0 10rpx 22rpx rgba(21, 37, 63, 0.12);
}

.remove-tag {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(17, 24, 39, 0.75);
  color: #ffffff;
  font-size: 20rpx;
}

.section-divider {
  margin-top: 32rpx;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #e5e7eb;
}

.layout-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.input-small {
  width: 100rpx !important;
  text-align: center;
}

.layout-label {
  font-size: 28rpx;
  color: #6b7280;
}

.checkbox-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 12rpx;
}

.checkbox-item {
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  background: #f3f4f6;
  font-size: 28rpx;
  color: #374151;
  transition: all 0.2s;
}

.checkbox-item.checked {
  background: #3b82f6;
  color: #ffffff;
}

.button-group {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.button-group .button {
  flex: 1;
  margin: 0;
}
