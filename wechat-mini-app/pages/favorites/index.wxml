<view class="page">
  <view class="page-header">
    <text class="page-title">我的收藏</text>
  </view>

  <view class="favorite-list" wx:if="{{!loading && favorites.length > 0}}">
    <view class="favorite-item" wx:for="{{favorites}}" wx:key="id">
      <view class="favorite-content" bindtap="goDetail" data-id="{{item.id}}">
        <view class="favorite-image" wx:if="{{item.imageUrls && item.imageUrls.length > 0}}">
          <image src="{{item.imageUrls[0]}}" mode="aspectFill" />
        </view>
        <view class="favorite-image placeholder" wx:else>
          <text>暂无图片</text>
        </view>
        <view class="favorite-info">
          <view class="favorite-title">{{item.title}}</view>
          <view class="favorite-meta">
            <text class="favorite-type">{{item.typeLabel}}</text>
            <text class="favorite-price">{{item.priceText}}</text>
          </view>
          <view class="favorite-location">{{item.locationText}}</view>
        </view>
      </view>
      <view class="favorite-action">
        <view class="unfavorite-btn" catchtap="removeFavorite" data-id="{{item.id}}">
          <text>取消收藏</text>
        </view>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{!loading && favorites.length === 0}}">
    <text class="empty-icon">☆</text>
    <text class="empty-text">暂无收藏</text>
    <text class="empty-hint">浏览房源并点击收藏，即可在此查看</text>
  </view>

  <view class="loading-state" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>
</view>
