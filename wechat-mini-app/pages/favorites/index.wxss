.page {
  min-height: 100vh;
  background: #f5f5f5;
}

.page-header {
  padding: 32rpx 32rpx 16rpx;
  background: #fff;
}

.page-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.favorite-list {
  padding: 16rpx;
}

.favorite-item {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}

.favorite-content {
  display: flex;
  padding: 20rpx;
}

.favorite-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.favorite-image image {
  width: 100%;
  height: 100%;
}

.favorite-image.placeholder {
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 24rpx;
}

.favorite-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.favorite-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.favorite-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 12rpx;
}

.favorite-type {
  font-size: 24rpx;
  color: #667eea;
  background: rgba(102, 126, 234, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.favorite-price {
  font-size: 28rpx;
  color: #ff4757;
  font-weight: 600;
}

.favorite-location {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.favorite-action {
  border-top: 1rpx solid #f0f0f0;
  padding: 16rpx 20rpx;
  display: flex;
  justify-content: flex-end;
}

.unfavorite-btn {
  font-size: 26rpx;
  color: #999;
  padding: 8rpx 20rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 32rpx;
}

.empty-icon {
  font-size: 80rpx;
  color: #ccc;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #999;
  text-align: center;
}

.loading-state {
  display: flex;
  justify-content: center;
  padding: 60rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}
